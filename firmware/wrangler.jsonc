// VALFRITT. Webbinstalleraren för rumskortens firmware, publicerad som en
// Cloudflare Worker med bara statiska filer (ingen egen kod). Det
// rekommenderade sättet är i stället att starta installeraren på den egna
// datorn (firmware/README.md). .github/workflows/firmware.yml bygger sidan
// till site/ i repots rot och publicerar den härifrån med wrangler deploy om
// Cloudflare-hemligheterna finns. Sidan nås då på
// https://homecontrol-installer.<ditt-namn>.workers.dev
// (Web Serial i webbläsaren kräver https eller localhost).
//
// Korten hämtar ingenting härifrån; de uppdateras över USB.
{
  "name": "homecontrol-installer",
  "compatibility_date": "2026-10-01",
  "assets": {
    // En fil som inte finns ger 404.
    "directory": "../site"
  },
  "workers_dev": true,
  // Inga extra förhandsadresser för varje version, bara den fasta adressen.
  "preview_urls": false
}
