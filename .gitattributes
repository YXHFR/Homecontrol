# Alla textfiler checkas ut med LF, även på Windows med core.autocrlf=true.
# Skript och konfiguration läses i Linux-containrar som inte tål CRLF.
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.example       text eol=lf
Dockerfile      text eol=lf
mosquitto/acl   text eol=lf

*.mp3   binary
*.wav   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.bin   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Windows-skript (webbinstallerarens starta.bat) behöver CRLF för att cmd ska läsa dem rätt.
*.bat   text eol=crlf
