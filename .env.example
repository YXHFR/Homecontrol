# Kopiera till .env och byt ut alla värden märkta "byt-mig":
#   cp .env.example .env
# .env är gitignorerad och får aldrig committas.

# --- Hemligheter (obligatoriska) ---
# Varje lösenord ska vara olika. Skapa dem med:  openssl rand -hex 24
#
# Databasens ägare (Postgres + TimescaleDB). Används bara när databasens
# tabeller skapas och uppdateras vid start. Byt det inte efter första
# starten: databasen minns det första lösenordet.
POSTGRES_PASSWORD=byt-mig
# Kärnans egen databasroll (homecontrol_core), som bara får läsa och skriva
# i tabellerna. Rollen skapas vid start om den saknas.
CORE_DATABASE_PASSWORD=byt-mig
# MQTT (Mosquitto). Kärnan (användaren homecontrol_core) och Zigbee2MQTT
# (användaren zigbee2mqtt) har var sin användare, som bara får de ämnen de
# behöver (se mosquitto/acl).
MQTT_CORE_PASSWORD=byt-mig
MQTT_ZIGBEE2MQTT_PASSWORD=byt-mig
# Lösenord för att logga in på Zigbee2MQTT:s webbsida.
ZIGBEE2MQTT_AUTH_TOKEN=byt-mig

# --- Rumskort (ESP32) ---
# Hemligheten som varje korts krypteringsnyckel räknas fram ur. Skapa den
# en gång med:  openssl rand -hex 32
# och byt den aldrig: då måste alla kort raderas och installeras om.
# Lämna tom så länge du inte har några kort; då är simuleringen påslagen
# från start och inga kort ansluts.
ESPHOME_SECRET=

# --- Zigbee (valfritt) ---
# Använd ANTINGEN ZIGBEE_ADAPTER (USB-sticka) ELLER ZIGBEE_SERIAL_PORT
# (adapter via nätverket), inte båda.
#
# USB-sticka: sökvägen på datorn. Hitta den med: ls /dev/serial/by-id/
# Lämna tom om ingen adapter är inkopplad än.
ZIGBEE_ADAPTER=
# Nätverksadapter: adress och port, t.ex. tcp://192.0.2.10:6638
#ZIGBEE_SERIAL_PORT=

# --- Nätverk (valfritt) ---
# Vilken adress portarna lyssnar på. 0.0.0.0 = alla nätverk datorn är
# ansluten till, 127.0.0.1 = bara den här datorn. Datorns adress i
# hemnätet (t.ex. 192.168.1.20) = bara hemnätet. Kärnan når också MQTT
# (och därmed Zigbee-lamporna) på den här adressen.
#BIND_ADDRESS=0.0.0.0
# Når du Homecontrol via ett namn i stället för en adress (t.ex.
# http://homecontrol.local:8000) skriver du namnet här. Flera namn skiljs
# med komma. localhost och vanliga adresser fungerar alltid.
#ALLOWED_HOSTS=homecontrol.local
# Porten på datorn där Homecontrols webbsida nås.
#WEB_PORT=8000
#MQTT_PORT=1883
#ZIGBEE2MQTT_PORT=8080
#TZ=Europe/Stockholm

# --- Historik (valfritt) ---
# Allt stannar i databasen på den här datorn (se README).
# Hur många timmar alla mätningar sparas (minst 1). Sedan finns en per
# sekund kvar.
#HISTORY_FULL_HOURS=24
# Hur många dagar historiken sparas över huvud taget. Måste vara längre än
# HISTORY_FULL_HOURS. Utan värde sparas den utan tidsgräns.
#HISTORY_KEEP_DAYS=365

# --- Dörrklocka (valfritt) ---
# Dörrklockan (XIAO ESP32S3 Sense) är avstängd så länge DOORBELL_NTFY_TOPIC
# är tom. Allt annat i Homecontrol fungerar som vanligt utan den. Se README,
# avsnittet Dörrklocka, för vad som skickas var.
#
# Ämnet i ntfy som notiserna skickas till. Den som kan gissa ämnet kan läsa
# notiserna (och se stillbilden), så gör det långt och slumpat:
#   openssl rand -hex 16
# Bara a–z, A–Z, 0–9, - och _.
DOORBELL_NTFY_TOPIC=
# ntfy-servern. Standard är https://ntfy.sh; en egen server ger full kontroll
# över var bilden hamnar.
#DOORBELL_NTFY_URL=https://ntfy.sh
# Inloggning hos ntfy (en "access token"), om ämnet är skyddat.
#DOORBELL_NTFY_TOKEN=
#
# Dörrklockans MQTT-lösenord. Samma värde ska stå som mqtt_password i
# firmware/secrets.yaml. Tomt: dörrklockan kan inte logga in.
#   openssl rand -hex 24
MQTT_DOORBELL_PASSWORD=
#
# Kameran: dörrklockans fasta IP-adress (ställ in den i routern) och nyckeln
# till dess krypterade API. Samma nyckel ska stå som api_key i
# firmware/secrets.yaml. Skapa den med:  openssl rand -base64 32
# Utan dem skickas notisen utan bild och sidan Dörren har ingen kamera.
#DOORBELL_CAMERA_HOST=192.168.1.30
#DOORBELL_CAMERA_KEY=
#
# Google Home-högtalarens fasta IP-adress, och volymen (0–100) som dingdong
# spelas med. Högtalaren får sedan tillbaka sin volym. Utan adress: inget ljud.
#DOORBELL_SPEAKER_HOST=192.168.1.40
#DOORBELL_SPEAKER_VOLUME=50
# Datorns adress i hemnätet, som högtalaren hämtar ljudet från. Räknas ut av
# sig själv; fyll bara i om högtalaren inte hittar ljudet.
#DOORBELL_MEDIA_HOST=192.168.1.20
# Ett eget ljud i stället för dingdong.mp3 som följer med: sökvägen i
# containern. Filen måste monteras dit (se README).
#DOORBELL_SOUND_FILE=/app/ljud/min-klocka.mp3
#
# Lampan som tänds i 30 sekunder när det ringer: namnet i Zigbee2MQTT, till
# exempel KAJPLATS hall. Den får sedan tillbaka sitt tidigare läge.
#DOORBELL_LAMP=
