# Kopiera till .env och byt ut alla värden märkta "byt-mig":
#   cp .env.example .env
# .env är gitignorerad och får aldrig committas.

# --- Hemligheter (obligatoriska) ---
# Lösenord till databasen (Postgres + TimescaleDB).
POSTGRES_PASSWORD=byt-mig
# Användare och lösenord för MQTT (Mosquitto). Används av Zigbee2MQTT och kärnan.
MQTT_USER=homecontrol
MQTT_PASSWORD=byt-mig

# --- Zigbee (valfritt) ---
# Sökväg till Zigbee-adaptern på värddatorn, t.ex.
# /dev/serial/by-id/usb-...  Lämna tom om ingen adapter är inkopplad än.
ZIGBEE_ADAPTER=
# Sätt till t.ex. tcp://192.0.2.10:6638 om du har en nätverksansluten adapter.
#ZIGBEE_SERIAL_PORT=/dev/zigbee

# --- Nätverk (valfritt) ---
# Vilken adress portarna lyssnar på. 0.0.0.0 = hela hemnätverket,
# 127.0.0.1 = bara den här datorn.
#BIND_ADDRESS=0.0.0.0
#HOMECONTROL_PORT=8000
#MQTT_PORT=1883
#ZIGBEE2MQTT_PORT=8080
#TZ=Europe/Stockholm
